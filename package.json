{
  "name": "bunkasai-ticket",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "check:layers": "node scripts/check-layers.ts",
    "lint": "pnpm check:layers && biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm --filter api typecheck && pnpm --filter web typecheck",
    "test": "pnpm --filter api test && pnpm --filter web test",
    "openapi:generate": "node scripts/openapi-generate.ts && biome format --write apps/web/src/api/openapi.json apps/web/src/api/schema.d.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "backup:rehearsal": "node scripts/backup-rehearsal.ts",
    "db:diff": "node scripts/db-diff.mjs",
    "db:validate": "node scripts/db-validate.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:status": "node scripts/db-status.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
