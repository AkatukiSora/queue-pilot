# Copy this file to .env.compose and replace the four generated secrets.
COMPOSE_POSTGRES_OWNER_PASSWORD=replace-with-a-random-32-byte-hex-value
COMPOSE_RUNTIME_DB_PASSWORD=replace-with-a-different-random-32-byte-hex-value
COMPOSE_AUTH_SECRET=replace-with-another-random-32-byte-hex-value
COMPOSE_OIDC_CLIENT_SECRET=replace-with-a-fourth-random-32-byte-hex-value

# Required by Compose interpolation; use real OAuth app credentials only for --profile github.
COMPOSE_GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
COMPOSE_GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Only used by the local JSON-file print-agent profile.
COMPOSE_API_BASE_URL=http://oidc-mock:8787
