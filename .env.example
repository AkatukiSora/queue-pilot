# Local development only. Replace every placeholder; never commit .env.
# Shared deployments use a non-owner runtime login and a separate migration login.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=queue_pilot
DB_USER=queue_pilot_runtime_login
DB_PASSWORD=replace-with-local-database-password
# disable is only for an isolated loopback development database.
# Remote or shared databases must use verify-full with a trusted CA file.
DB_SSLMODE=disable
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/path/to/trusted-ca.pem
# Legacy URI mode: comment out every DB_* setting above before using DATABASE_URL.
# DATABASE_URL=postgresql://queue_pilot_runtime_login:replace-me@127.0.0.1:5432/queue_pilot?sslmode=disable
# Legacy-only settings for isolated development. Do not use with oidc/shared.
# ADMIN_TOKEN=generate-a-separate-random-value-of-at-least-32-characters
# AGENT_TOKEN=generate-a-different-random-value-of-at-least-32-characters
# EVENT_END_AT=2099-01-01T02:00:00Z
# SLOT_SCHEDULE_JSON='[{"date":"2099-01-01","firstStart":"10:00","lastStart":"10:30"}]'
# TICKET_NUMBER_SCOPE=daily
# manifest preserves the existing deployment behavior. Use database for DB-authoritative shared configuration;
# in database mode no tenant manifest file or mount is required.
TENANT_CONFIG_SOURCE=manifest
APP_MANIFEST_PATH=deploy/examples/compose/tenant-manifest.json
AUTH_MODE=oidc/shared
AUTH_PROVIDER=github
AUTH_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=https://tickets.example.invalid
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
# Optional trusted proxy IP/CIDR list for X-Forwarded-For parsing; leave unset unless verified.
# AUTH_TRUSTED_PROXIES='["192.0.2.0/24","2001:db8:ffff::/48"]'
# For OIDC, set AUTH_PROVIDER=oidc and these values instead of GitHub settings.
# OIDC_ISSUER=https://identity.example.invalid
# OIDC_DISCOVERY_URL=https://identity.example.invalid/.well-known/openid-configuration
# OIDC_CLIENT_ID=replace-with-oidc-client-id
# OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
