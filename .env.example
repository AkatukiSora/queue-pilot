# Generate independent values with: openssl rand -base64 32
# Each token must be at least 32 characters and contain no whitespace.
DATABASE_URL=postgres://ticket:password@127.0.0.1:5432/ticket
ADMIN_TOKEN=replace-with-a-random-token-of-at-least-32-characters
AGENT_TOKEN=replace-with-a-different-random-token-of-at-least-32-characters
EVENT_END_AT=2026-11-04T14:00:00+09:00
SLOT_SCHEDULE_JSON='[{"date":"2026-11-03","firstStart":"10:00","lastStart":"14:30"},{"date":"2026-11-04","firstStart":"10:00","lastStart":"13:30"}]'
TICKET_NUMBER_SCOPE=daily
