[Unit]
Description=Bunkasai Ticket Print Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=print-agent
SupplementaryGroups=lp
EnvironmentFile=/etc/bunkasai-ticket/print-agent.env
ExecStart=/usr/local/bin/print-agent
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=2
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=print-agent
StateDirectoryMode=0750
DevicePolicy=closed
# Keep this path aligned with devicePath in the v2 JSON config (or DEVICE_PATH in legacy mode).
DeviceAllow=/dev/usb/lp0 rw

[Install]
WantedBy=multi-user.target
